# Copy to .env and fill in. .env is git-ignored: never commit a real key.

# --- Server (npm run server / npm start) ---

# Real photo classifier, option 1 (works on Render): a free vision model through OpenRouter.
# Make a free key at https://openrouter.ai (Keys page). Free models allow about 50 photos a day.
# Leave empty to use the demo classifier ("AI suggestion (demo)").
OPENROUTER_API_KEY=

# Optional: up to three OpenRouter model ids to try in order, comma-separated.
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# Optional: openrouter, clip or simulated. Default: OpenRouter if a key is set, otherwise demo.
# Option 2, CLASSIFIER=clip, runs the CLIP image model on this machine: no key, downloads about 90 MB once,
# needs about 400-500 MB of memory (not for Render's free plan).
# CLASSIFIER=
# MODEL_CACHE_DIR=

# Port for the API server (default 8787).
PORT=8787

# Where the SQLite database and uploaded photos live (defaults shown).
# DB_PATH=server/data/reachable.db
# UPLOADS_DIR=uploads

# Allowed browser origin when the frontend is hosted elsewhere, e.g. https://reachable.vercel.app
# Default: any origin.
# CORS_ORIGIN=

# --- Frontend build (npm run build) ---

# API origin when the frontend and API are on different hosts, e.g. https://reachable-api.onrender.com
# Leave empty when using the Vite dev proxy or `npm start` (same origin).
# VITE_API_URL=
