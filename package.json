{
  "name": "reachable",
  "private": true,
  "version": "1.0.0",
  "description": "REACHABLE: a live campus accessibility map with verification-aware routing",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "demo:check": "node scripts/demo-check.mjs",
    "clip:check": "tsx scripts/clip-check.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
